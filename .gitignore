########################################
# HostelHub — Root .gitignore
# Covers all microservice sub-modules
########################################

# ──────────────────────────────────────
# Maven build output
# ──────────────────────────────────────
**/target/
!**/src/main/**/target/
!**/src/test/**/target/
*.jar
*.war
*.ear
*.class

# Maven wrapper jar (downloaded on first build)
**/.mvn/wrapper/maven-wrapper.jar

# ──────────────────────────────────────
# IntelliJ IDEA
# ──────────────────────────────────────
.idea/
*.iws
*.iml
*.ipr
out/
.idea_modules/

# ──────────────────────────────────────
# Eclipse / Spring Tool Suite (STS)
# ──────────────────────────────────────
.apt_generated
.classpath
.factorypath
.project
.settings/
.springBeans
.sts4-cache
bin/

# ──────────────────────────────────────
# NetBeans
# ──────────────────────────────────────
nbproject/private/
nbbuild/
dist/
nbdist/
.nb-gradle/
build/
!**/src/main/**/build/
!**/src/test/**/build/

# ──────────────────────────────────────
# VS Code
# ──────────────────────────────────────
.vscode/
*.code-workspace

# ──────────────────────────────────────
# Operating System files
# ──────────────────────────────────────
# Windows
Thumbs.db
Thumbs.db:encryptable
ehthumbs.db
ehthumbs_vista.db
[Dd]esktop.ini
$RECYCLE.BIN/
*.lnk

# macOS
.DS_Store
.AppleDouble
.LSOverride
._*
.Spotlight-V100
.Trashes
.fseventsd

# Linux
*~

# ──────────────────────────────────────
# Secrets & Environment Files
# ──────────────────────────────────────
# Never commit real credentials or secrets.
# Use application-local.properties or .env for local overrides.
.env
*.env
.env.*
!.env.example
application-local.properties
application-local.yml
application-secrets.properties
**/src/main/resources/application-local.properties
**/src/main/resources/application-local.yml
**/src/main/resources/application-secrets.properties

# ──────────────────────────────────────
# Log files
# ──────────────────────────────────────
*.log
logs/
**/logs/

# ──────────────────────────────────────
# Patch / diff files
# ──────────────────────────────────────
*.orig
*.rej
*.patch

# ──────────────────────────────────────
# Spring Boot DevTools restart trigger
# ──────────────────────────────────────
.reloadtrigger

# ──────────────────────────────────────
# Temporary files
# ──────────────────────────────────────
*.tmp
*.bak
*.swp
*.swo
*#

# ──────────────────────────────────────
# Docker (if added later)
# ──────────────────────────────────────
docker-compose.override.yml
