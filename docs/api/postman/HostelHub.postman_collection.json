            },
            "url": {
              "raw": "{{baseUrl}}/api/leaves?studentId={{studentId}}",
              "host": ["{{baseUrl}}"],
              "path": ["api", "leaves"],
              "query": [{ "key": "studentId", "value": "{{studentId}}" }]
            }
          }
        },
        {
          "name": "Get Leave by ID",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/api/leaves/{{leaveId}}",
              "host": ["{{baseUrl}}"],
              "path": ["api", "leaves", "{{leaveId}}"]
            }
          }
        },
        {
