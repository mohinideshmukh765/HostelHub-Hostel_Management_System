    {
      "name": "leave-service",
      "description": "Student leave request lifecycle. Port 8095, routed via gateway at /api/leaves/**\nAuth via UUID query param only. Optimistic locking on accept via @Version.",
      "item": [
        {
          "name": "Apply for Leave",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "var jsonData = pm.response.json();",
                  "if (jsonData.id) { pm.collectionVariables.set('leaveId', jsonData.id); }"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
