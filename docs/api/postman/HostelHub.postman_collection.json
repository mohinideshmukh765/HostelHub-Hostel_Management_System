{
  "info": {
    "name": "HostelHub API",
    "description": "Complete HostelHub API collection. One folder per service.\n\nEnvironment variables:\n- {{baseUrl}} = http://localhost:8080 (via api-gateway)\n- {{gatewayUrl}} = http://localhost:8080\n- {{token}} = JWT access token (auto-populated by Login request)\n- {{studentId}} = UUID of registered student (auto-populated by Register/Login)\n- {{wardenId}} = UUID of created warden (set manually after Create Warden)\n- {{hostelId}} = UUID of created hostel (auto-populated by Create Hostel)\n- {{roomId}} = UUID of created room (auto-populated by Create Room)\n- {{bedId}} = UUID of created bed (auto-populated by Create Bed)\n- {{allocationId}} = UUID of allocation (auto-populated by Create Allocation)\n- {{complaintId}} = UUID of complaint (auto-populated by File Complaint)\n- {{leaveId}} = UUID of leave (auto-populated by Apply for Leave)",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:8080", "type": "string" },
    { "key": "gatewayUrl", "value": "http://localhost:8080", "type": "string" },
    { "key": "token", "value": "", "type": "string" },
    { "key": "studentId", "value": "", "type": "string" },
    { "key": "wardenId", "value": "", "type": "string" },
    { "key": "hostelId", "value": "", "type": "string" },
    { "key": "roomId", "value": "", "type": "string" },
    { "key": "bedId", "value": "", "type": "string" },
    { "key": "allocationId", "value": "", "type": "string" },
    { "key": "complaintId", "value": "", "type": "string" },
    { "key": "leaveId", "value": "", "type": "string" }
  ],
  "item": [
    {
      "name": "identity-service",
      "description": "User registration, login, JWT management. Port 8081, routed via gateway at /api/auth/**",
      "item": [
        {
          "name": "Register Student",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "var jsonData = pm.response.json();",
                  "if (jsonData.accessToken) { pm.collectionVariables.set('token', jsonData.accessToken); }",
                  "if (jsonData.user && jsonData.user.id) { pm.collectionVariables.set('studentId', jsonData.user.id); }"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"firstName\": \"Priya\",\n  \"lastName\": \"Sharma\",\n  \"email\": \"priya.sharma@example.com\",\n  \"password\": \"securePass1\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/auth/register",
              "host": ["{{baseUrl}}"],
              "path": ["api", "auth", "register"]
            }
          }
        },
        {
          "name": "Login",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "var jsonData = pm.response.json();",
                  "if (jsonData.accessToken) { pm.collectionVariables.set('token', jsonData.accessToken); }",
                  "if (jsonData.user && jsonData.user.id) { pm.collectionVariables.set('studentId', jsonData.user.id); }"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"priya.sharma@example.com\",\n  \"password\": \"securePass1\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/auth/login",
              "host": ["{{baseUrl}}"],
              "path": ["api", "auth", "login"]
            }
          }
        },
        {
          "name": "Refresh Token",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"refreshToken\": \"PASTE_REFRESH_TOKEN_HERE\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/auth/refresh",
              "host": ["{{baseUrl}}"],
              "path": ["api", "auth", "refresh"]
            }
          }
        },
        {
          "name": "Logout",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"refreshToken\": \"PASTE_REFRESH_TOKEN_HERE\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/auth/logout",
              "host": ["{{baseUrl}}"],
              "path": ["api", "auth", "logout"]
            }
          }
        },
        {
          "name": "Get My Profile",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "url": {
              "raw": "{{baseUrl}}/api/auth/me",
              "host": ["{{baseUrl}}"],
              "path": ["api", "auth", "me"]
            }
          }
        },
        {
          "name": "Create Warden (ADMIN only — currently open)",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"firstName\": \"Rajesh\",\n  \"lastName\": \"Kumar\",\n  \"email\": \"rajesh.kumar@hostel.edu\",\n  \"password\": \"wardenPass1\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/auth/admin/wardens",
              "host": ["{{baseUrl}}"],
              "path": ["api", "auth", "admin", "wardens"]
            }
          }
        },
        {
          "name": "Create Admin (ADMIN only — currently open)",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"firstName\": \"Sunita\",\n  \"lastName\": \"Patil\",\n  \"email\": \"sunita.patil@hostel.edu\",\n  \"password\": \"adminPass1\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/auth/admin/admins",
              "host": ["{{baseUrl}}"],
              "path": ["api", "auth", "admin", "admins"]
            }
          }
        },
        {
          "name": "Internal — Get User by ID",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/api/internal/users/{{studentId}}",
              "host": ["{{baseUrl}}"],
              "path": ["api", "internal", "users", "{{studentId}}"]
            }
          }
        }
      ]
    },
    {
      "name": "hostel-service",
      "description": "Hostels, rooms, beds. Port 8092, routed via gateway at /api/hostels/**\nNo auth enforced on any endpoint today.",
      "item": [
