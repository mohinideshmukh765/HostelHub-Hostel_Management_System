            }
          }
        },
        {
          "name": "Get Hostel Leaves",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/api/leaves/hostel/{{hostelId}}",
              "host": ["{{baseUrl}}"],
              "path": ["api", "leaves", "hostel", "{{hostelId}}"]
            }
          }
        },
        {
          "name": "Get All Leaves (optional status filter)",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/api/leaves?status=PENDING",
              "host": ["{{baseUrl}}"],
              "path": ["api", "leaves"],
              "query": [{ "key": "status", "value": "PENDING", "description": "Optional. Values: PENDING, IN_REVIEW, APPROVED, REJECTED, CANCELLED" }]
            }
          }
        },
        {
          "name": "Update Leave (student, PENDING only)",
          "request": {
            "method": "PUT",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"startDate\": \"2026-09-06\",\n  \"endDate\": \"2026-09-11\",\n  \"reason\": \"Wedding extended by one day\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/leaves/{{leaveId}}?studentId={{studentId}}",
              "host": ["{{baseUrl}}"],
              "path": ["api", "leaves", "{{leaveId}}"],
              "query": [{ "key": "studentId", "value": "{{studentId}}" }]
            }
          }
        },
        {
          "name": "Cancel Leave (student, PENDING only)",
          "request": {
            "method": "DELETE",
            "url": {
              "raw": "{{baseUrl}}/api/leaves/{{leaveId}}?studentId={{studentId}}",
              "host": ["{{baseUrl}}"],
              "path": ["api", "leaves", "{{leaveId}}"],
              "query": [{ "key": "studentId", "value": "{{studentId}}" }]
            }
          }
        },
        {
          "name": "Warden — Accept Leave (PENDING → IN_REVIEW)",
          "request": {
            "method": "PUT",
            "url": {
              "raw": "{{baseUrl}}/api/leaves/{{leaveId}}/accept?wardenId={{wardenId}}",
              "host": ["{{baseUrl}}"],
              "path": ["api", "leaves", "{{leaveId}}", "accept"],
              "query": [{ "key": "wardenId", "value": "{{wardenId}}" }]
            }
          }
        },
        {
          "name": "Warden — Approve Leave (IN_REVIEW → APPROVED)",
          "request": {
            "method": "PUT",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"status\": \"APPROVED\",\n  \"remarks\": \"Approved for family function. Travel dates verified.\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/leaves/{{leaveId}}/status?wardenId={{wardenId}}",
